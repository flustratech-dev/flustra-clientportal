APP_NAME="Flustra Client Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8008

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_flustra-clientportal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# Google OAuth
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ============================================================
# Integrasi flustra-erp
# ============================================================
# Nilai ERP_API_TOKEN harus SAMA dengan PORTAL_API_TOKEN di flustra-erp/.env,
# dan ERP_WEBHOOK_SECRET harus SAMA dengan PORTAL_WEBHOOK_SECRET di sana.
# Buat nilainya sekali dengan:
#   php artisan tinker --execute="echo bin2hex(random_bytes(32));"
ERP_API_URL=http://localhost:8006/api/portal/v1
ERP_API_TOKEN=
ERP_WEBHOOK_SECRET=
ERP_TIMEOUT=15

# Umur maksimum webhook masuk yang masih diterima (detik).
ERP_WEBHOOK_MAX_AGE=300

# Berapa lama URL bukti klaim yang dikirim ke ERP tetap bisa dibuka staf (hari).
ERP_EVIDENCE_URL_DAYS=7

# ============================================================
# Perilaku portal
# ============================================================
# Pendaftaran terbuka & instan. Ini SENGAJA berbeda dari flustra-erp:
# di sini tidak ada halaman "menunggu persetujuan admin".
PORTAL_REGISTRATION_OPEN=true
PORTAL_MAX_UPLOAD_KB=5120
PORTAL_SIGNED_URL_MINUTES=5

# Kontak yang tampil di halaman Bantuan.
PORTAL_CONTACT_EMAIL="officeflustra@gmail.com"
PORTAL_CONTACT_WHATSAPP=

# ============================================================
# Notifikasi WhatsApp lewat flustra-wa
# ============================================================
WA_GATEWAY_ENABLED=true
WA_GATEWAY_URL=https://wa.flustra.id
WA_GATEWAY_KEY=
WA_GATEWAY_SESSION=
WA_GATEWAY_TIMEOUT=5
WA_GATEWAY_CONNECT_TIMEOUT=2
